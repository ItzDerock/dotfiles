+    }
+#endif
+
+    aCanvas->SetSwapInterval( aVal );
+    int interval = aCanvas->GetSwapInterval();
+
+    // GAL uses zero for both disabled and unknown synchronization.
+    return interval == wxGLCanvas::DefaultSwapInterval ? 0 : interval;
