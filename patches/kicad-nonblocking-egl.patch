+#if wxCHECK_VERSION( 3, 3, 3 )
+#ifdef __WXGTK__
+    if( aCanvas->GetEGLVersion( nullptr, nullptr ) )
+    {
+        // EGL turns adaptive vsync into ordinary vsync.  An occluded canvas can then
+        // wait indefinitely for a compositor frame callback, blocking every editor
+        // on the GUI thread.  Use the draw panel's timer-based pacing instead.
+        aCanvas->SetSwapInterval( 0 );
