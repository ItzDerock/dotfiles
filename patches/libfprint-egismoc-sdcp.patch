+  g_autofree gchar *hex = OPENSSL_buf2hexstr (random, SDCP_RANDOM_SIZE);
+
+  fp_dbg ("Generated random:\n%s", hex);
+
+  g_assert (memcmp (random, random_zeroes, SDCP_RANDOM_SIZE) != 0);
+}
